[Desktop Entry]
Type=Application
Name=RVM Kiosk
Comment=Auto-launch the RVM kiosk display in fullscreen Chromium on boot
Exec=/home/adi/RVM/deploy/rvm-kiosk-launch.sh
X-GNOME-Autostart-enabled=true

# Install (run as the desktop user that auto-logs-in on boot):
#   mkdir -p ~/.config/autostart
#   cp deploy/rvm-kiosk-autostart.desktop ~/.config/autostart/
#   chmod +x deploy/rvm-kiosk-launch.sh
#
# The Chromium flags live in deploy/rvm-kiosk-launch.sh, not here: the launcher
# waits for the local web app, then starts Chromium with --kiosk and
# --password-store=basic (without it gnome-keyring pops up "Choose password for
# new keyring" on first boot and blanks the kiosk). It logs to ~/kiosk-boot.log.
# Change the path above if the project is not in /home/adi/RVM.
#
# Replace RVM-001 in deploy/rvm-kiosk-launch.sh with the actual machine_code for
# this physical unit.
#
# Screen blanking is disabled separately via `sudo raspi-config` -> Display
# Options -> Screen Blanking (Raspberry Pi OS Bookworm+ uses Wayland, so the
# old xset/lxsession approach no longer applies).
