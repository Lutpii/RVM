[Unit]
Description=RVM AI Service (YOLOv8 classification + camera + sorting servos)
After=network.target pigpiod.service
Requires=pigpiod.service

[Service]
Type=simple
User=adi
Group=adi
# Needs the "gpio" and "video" supplementary groups on the User above
# (sudo usermod -aG gpio,video adi) for servo + camera access.
WorkingDirectory=/home/adi/RVM/BackEnd/ai_service
Environment="AI_API_KEY=rvm_ai_secret_key_2024"
# Unbuffered stdout — otherwise Python batches print() output when it's not
# attached to a terminal (as under systemd), so journalctl can lag several
# minutes behind what's actually happening (servo/camera log lines included).
Environment="PYTHONUNBUFFERED=1"
# Reuses the existing venv at /home/adi/RVM_test/venv (already has torch/ultralytics/
# picamera2/opencv installed) instead of a fresh venv inside ai_service/ — avoids
# re-downloading multiple GB of ML packages that don't fit on the SD card twice.
ExecStart=/home/adi/RVM_test/venv/bin/python /home/adi/RVM/BackEnd/ai_service/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

# Install:
#   sudo cp deploy/rvm-ai.service /etc/systemd/system/rvm-ai.service
#   sudo systemctl daemon-reload
#   sudo systemctl start rvm-ai
#
# Don't `enable` it on a kiosk Pi: the kiosk launcher starts it once the page
# is up (see deploy/rvm-kiosk-launch.sh, deploy/sudoers-rvm-kiosk), with
# deploy/rvm-ai.timer as the fallback. Enabling it makes the torch import run
# during boot again, alongside Chromium.
#
# Logs:
#   journalctl -u rvm-ai -f
