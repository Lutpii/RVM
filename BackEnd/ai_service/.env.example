# Required — no default. Must match BackEnd/.env's AI_SERVICE_KEY exactly.
AI_API_KEY=

# Comma-separated origins allowed to call this service from a browser.
ALLOWED_ORIGINS=https://localhost:5173,https://localhost:4173

# Optional — absolute path to a .pt weights file to use instead of the
# auto-detected best_exp6.pt/best.pt candidates.
# MODEL_PATH=

# Optional — which /dev/videoN (Linux) or DirectShow index (Windows) to use
# for the USB webcam fallback when more than one camera is present.
# USB_CAMERA_INDEX=0

# Optional — set to 180 if the USB webcam is mounted upside-down. Applied to
# both the preview stream and the frames YOLO classifies.
# USB_CAMERA_ROTATE=180
