# Required — no default. Must match BackEnd/.env's AI_SERVICE_KEY exactly.
AI_API_KEY=

# Comma-separated origins allowed to call this service from a browser.
ALLOWED_ORIGINS=https://localhost:5173,https://localhost:4173

# Optional — absolute path to a .pt weights file to use instead of the
# auto-detected best_exp6.pt/best.pt candidates.
# MODEL_PATH=

# Optional — which /dev/videoN (Linux) or DirectShow index (Windows) to use
# for the USB webcam fallback when more than one camera is present.
# USB_CAMERA_INDEX=0

# Optional — set to 180 if the USB webcam is mounted upside-down. Applied to
# both the preview stream and the frames YOLO classifies.
# USB_CAMERA_ROTATE=180

# Optional — set to 1 on a kiosk Pi to keep the USB webcam open between scans
# (saves ~1 s per capture). Leave unset on a dev laptop, where the browser's
# QR scan needs the same webcam.
# USB_CAMERA_KEEP_OPEN=1

# Compactor driver for the 2-bin DSME machine:
#   gpio        - the real flap servos, compactor and tilt (Raspberry Pi with
#                 python3-gpiozero + python3-lgpio; venv with system site packages)
#   placeholder - default; sleeps for the real durations (gate ~10 s,
#                 compact+tilt ~24 s) without touching GPIO
# Only one process may own the GPIO pins: stop rvm-ai before running the DSME
# bench script (rvm_combined.py) by hand.
# HW_DRIVER=placeholder
# Multiply every hardware duration, e.g. 0.1 for fast local testing.
# HW_TIME_SCALE=1.0
