APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rvm_db
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Default below is a local dev mail catcher (mailpit) — nothing actually gets
# delivered. To send real emails (e.g. the PBT bin-collection notification),
# point this at a real SMTP relay instead — e.g. Resend (https://resend.com):
#   MAIL_HOST=smtp.resend.com / MAIL_PORT=587 / MAIL_USERNAME=resend
#   MAIL_PASSWORD=<your Resend API key> / MAIL_ENCRYPTION=tls
#   MAIL_FROM_ADDRESS=onboarding@resend.dev (works without domain verification;
#   verify your own domain on Resend to send from a custom address instead)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ========================
# RVM-specific settings
# ========================

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Fonnte WhatsApp OTP (https://fonnte.com)
FONNTE_API_TOKEN=
FONNTE_SENDER=

# Python AI classification service (BackEnd/ai_service)
# Required — no default. Generate your own (e.g. `openssl rand -base64 32`) and
# set the identical value as AI_API_KEY in ai_service/.env.
AI_SERVICE_URL=http://localhost:5000
AI_SERVICE_KEY=

# Vue frontend URL — used for the Google OAuth redirect and to build QR scan links
FRONTEND_URL=https://localhost:5173

# Recipient for the "bin collection requested" email (AdminController::requestBinCollection).
# Leave empty to skip sending — the request is still logged either way.
PBT_NOTIFICATION_EMAIL=
